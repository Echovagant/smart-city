# Application
APP_NAME=SmartCityBackend

# Server
# Set DEBUG=False for any non-dev environment.
DEBUG=True
HOST=127.0.0.1
PORT=8001

# CORS — comma-separated list of allowed origins.
# For local dev with the Vite frontend on 5173, leave as-is.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data directories (relative to backend-python/)
DATA_DIR=./data
GEOJSON_DIR=./geojson