# Application
APP_NAME=SmartCityBackend

# Server
# Set DEBUG=False for any non-dev environment.
DEBUG=True
HOST=127.0.0.1
PORT=8000

# CORS — comma-separated list of allowed origins.
# For local dev with the Vite frontend on 5173, leave as-is.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional shared API key. Leave empty to disable the check entirely (dev default).
# When set, /api/buildings and /api/roads require the X-API-Key header.
API_KEY=

# Host header allowlist, comma-separated. Empty means no restriction.
ALLOWED_HOSTS=

# Expose /docs /redoc /openapi.json. Keep False in production.
EXPOSE_DOCS=False

# Data directories are hardcoded in main.py to backend-python/data and backend-python/geojson
# (no longer configurable here — change the constants in main.py to relocate).
